# Copier vers windows-studio/.env (gitignored) pour un build signé local.
# Ne jamais committer de certificat ni de mot de passe.

# --- Authenticode (optionnel) ---
# Chemin vers le certificat code-signing (PFX / P12) émis pour STICK RDC / TIC-TAC.
# TICTAC_CODE_SIGN_PFX=C:\certs\stickrdc-codesign.pfx

# Mot de passe du PFX (si le fichier est protégé).
# TICTAC_CODE_SIGN_PASSWORD=

# Alternative CI : contenu PFX en base64 (évite un fichier sur disque).
# TICTAC_CODE_SIGN_PFX_BASE64=

# Alternative : empreinte SHA1 d'un certificat déjà importé dans le magasin Windows.
# TICTAC_CODE_SIGN_THUMBPRINT=

# Horodatage RFC3161 (défaut DigiCert si omis).
# TICTAC_CODE_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com

# Chemin explicite vers signtool.exe (sinon détection Windows SDK).
# TICTAC_CODE_SIGN_TOOL=

# Chemin explicite vers ISCC.exe (Inno Setup 6).
# TICTAC_ISCC=C:\Program Files (x86)\Inno Setup 6\ISCC.exe
